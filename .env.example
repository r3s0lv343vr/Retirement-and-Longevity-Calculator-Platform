# Optional: Google AdSense publisher id for live ads.
# Leave empty to show labeled placeholder slots.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional. Only if you want the admin password in the environment instead of
# creating it at /admin on first visit (stored hashed in .data/admin.json).
ADMIN_PASSWORD=

# Optional. Persist visitor counts and the admin password hash across deploys
# (Upstash Redis or Vercel KV). A normal server uses .data/ instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
