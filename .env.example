# Optional: Google AdSense publisher id for live ads (ca-pub-…).
# Leave empty to hide ad slots. Set this on the host
# (Vercel or Hostinger), not in the /admin dashboard.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: one AdSense display unit id (digits only) used by every slot.
NEXT_PUBLIC_ADSENSE_SLOT=

# Optional. Only if you want the admin password in the environment instead of
# creating it at /admin on first visit (stored hashed in .data/admin.json).
ADMIN_PASSWORD=

# Optional. Persist visitor counts and the admin password hash across deploys
# (Upstash Redis or Vercel KV). A normal server uses .data/ instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
