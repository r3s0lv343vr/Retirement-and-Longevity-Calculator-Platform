# Optional: Google AdSense publisher id for live ads.
# Leave empty to show labeled placeholder slots.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Admin dashboard at /admin. Required in production.
# Locally, if unset, the password is "dev-admin".
ADMIN_PASSWORD=

# Optional. Persist visitor counts across Vercel deploys (Upstash Redis or Vercel KV).
# Without this, counts live in a local file or in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
